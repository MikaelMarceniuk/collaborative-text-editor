NODE_ENV=development
PORT=3333

MONGO_URL=mongodb://localhost:27017/collaborative-editor?directConnection=true # Local replica set from compose-dev.yml. For Atlas, use the mongodb+srv:// URL

BETTER_AUTH_SECRET= # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3333 # Base URL of the API

RESEND_API_KEY= # https://resend.com/api-keys. Optional in development (emails are logged to the console), required otherwise
MAIL_FROM="Name <you@your-domain.com>" # Optional, defaults to onboarding@resend.dev

WEB_URL=http://localhost:5173
