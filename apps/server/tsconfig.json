{
	"compilerOptions": {
		"target": "es2023",
		"lib": ["ES2023"],
		"types": ["node"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"rootDir": "src",
		"outDir": "dist",
		"sourceMap": true,
		"skipLibCheck": true,

		"strict": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"erasableSyntaxOnly": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true
	},
	"include": ["src"]
}
