{
	"name": "@collaborative-text-editor/server",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"start:dev": "tsx watch --env-file=.env src/server.ts",
		"start:prd": "node --env-file=.env dist/server.js",
		"build": "tsc",
		"typecheck": "tsc -p tsconfig.test.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "oxlint",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"dependencies": {
		"@better-auth/mongo-adapter": "^1.7.12",
		"better-auth": "^1.7.12",
		"cors": "^2.8.6",
		"express": "^5.3.0",
		"mongodb": "~7.7.0",
		"resend": "^6.34.1",
		"yjs": "^13.6.33",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^24.19.2",
		"@types/supertest": "^7.2.1",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"supertest": "^7.3.2",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"vitest": "^5.1.1"
	}
}
